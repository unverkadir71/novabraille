# Nova Braille — Environment Configuration
# Kopyala: cp .env.example .env
# Plan v9 referansı: Bölüm 1.5 (Hosted/Self-hosted Modları)

# ========================
# Uygulama Modu
# ========================
# hosted     = SaaS, ödeme/abonelik etkin, PostgreSQL zorunlu
# self_hosted = Açık kaynak, ödeme kapalı, SQLite veya PostgreSQL
# development = Yerel geliştirme, SQLite varsayılan
APP_MODE=development

# ========================
# Veritabanı
# ========================
# Development: sqlite+aiosqlite:///./nova-braille.db
# Production hosted: postgresql+asyncpg://user:pass@db:5432/novabraille
# Production self_hosted: postgresql+asyncpg://user:pass@localhost:5432/novabraille
DATABASE_URL=sqlite+aiosqlite:///./nova-braille.db

# ========================
# Güvenlik
# ========================
# openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes

# ========================
# E-posta (SMTP)
# ========================
# Hosted: zorunlu. Self-hosted: isteğe bağlı.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@novabraille.example.com
SMTP_USE_TLS=true

# ========================
# Redis (worker kuyruğu + rate limit)
# ========================
# Production: redis://redis:6379/0
# Development: opsiyonel, boş bırakılırsa sync çalışır
REDIS_URL=

# ========================
# Self-Hosted Ayarları (yalnızca APP_MODE=self_hosted)
# ========================
# Kayıt politikası: open (herkese açık) veya closed (yalnızca admin davet eder)
SELF_HOSTED_REGISTRATION=closed
# Kullanıcı başına karakter kotası (0 = sınırsız)
SELF_HOSTED_CHAR_LIMIT=0

# ========================
# Billing (yalnızca APP_MODE=hosted)
# ========================
# Ödeme sağlayıcı: paddle, polar, lemon_squeezy
BILLING_PROVIDER=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=

# ========================
# Liblouis
# ========================
# Tablo dizini (varsayılan: sistem kurulumu)
LIBLOUIS_TABLE_DIR=

# ========================
# Diğer
# ========================
# Zaman dilimi
TZ=Europe/Istanbul
# Log seviyesi: debug, info, warning, error
LOG_LEVEL=info
# Sentry DSN (opsiyonel)
SENTRY_DSN=